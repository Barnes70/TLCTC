{
  "name": "tlctc",
  "version": "2.3.2",
  "description": "TLCTC (Top Level Cyber Threat Clusters) — a cause-oriented, axiomatic cyber threat taxonomy framework. See https://www.tlctc.net",
  "scripts": {
    "validate-framework": "node scripts/validate-framework.js json-schemas/layer-1/tlctc-framework.schema.json json-schemas/layer-1/tlctc-framework.v2.4.json",
    "build-okf": "node scripts/build-okf.js",
    "validate-okf": "node scripts/validate-okf.js okf",
    "validate": "npm run validate-framework && npm run build-okf && npm run validate-okf",
    "test": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barnes70/TLCTC.git"
  },
  "keywords": [
    "tlctc",
    "cyber-threat-taxonomy",
    "threat-modeling",
    "cybersecurity",
    "attack-path",
    "threat-classification"
  ],
  "author": "Bernhard Kreinz",
  "license": "CC-BY-4.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Barnes70/TLCTC/issues"
  },
  "homepage": "https://github.com/Barnes70/TLCTC#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "marked": "^18.0.5",
    "puppeteer": "^24.40.0"
  }
}
