{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "tlctc-sonar",
          "informationUri": "https://www.tlctc.net",
          "version": "1.0.0",
          "rules": [
            {
              "id": "tlctc-02",
              "name": "ExploitingServer",
              "shortDescription": {
                "text": "#2 Exploiting Server"
              },
              "fullDescription": {
                "text": "A server-role component has a coding/implementation flaw (per TLCTC #2)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tlctc": {
                  "cluster": "#2"
                }
              }
            },
            {
              "id": "tlctc-03",
              "name": "ExploitingClient",
              "shortDescription": {
                "text": "#3 Exploiting Client"
              },
              "fullDescription": {
                "text": "A client-role component has a coding/implementation flaw (per TLCTC #3)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tlctc": {
                  "cluster": "#3"
                }
              }
            },
            {
              "id": "tlctc-04",
              "name": "IdentityTheft",
              "shortDescription": {
                "text": "#4 Identity Theft"
              },
              "fullDescription": {
                "text": "A credential, key, or session artifact is stolen, forged, or applied (per TLCTC #4)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tlctc": {
                  "cluster": "#4"
                }
              }
            },
            {
              "id": "tlctc-10",
              "name": "SupplyChainAttack",
              "shortDescription": {
                "text": "#10 Supply Chain Attack"
              },
              "fullDescription": {
                "text": "A trusted artifact carrying attacker control is accepted (per TLCTC #10)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tlctc": {
                  "cluster": "#10"
                }
              }
            }
          ],
          "properties": {
            "tlctc_version": "2.1",
            "sonar_project": "demo"
          }
        }
      },
      "results": [
        {
          "ruleId": "tlctc-02",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "Format SQL queries using parameterized binding rather than string concatenation."
