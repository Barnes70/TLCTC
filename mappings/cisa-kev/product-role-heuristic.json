{
  "metadata": {
    "title": "TLCTC KEV Product-Role Heuristic",
    "description": "Vendor/product-pattern rules that resolve R-ROLE server-vs-client ambiguity. Applied ONLY when a source CWE maps to '#2 | #3' (or any expression containing that alternation). Recovers context information that KEV vendorProject/product already encodes but a bare CWE lookup throws away.",
    "version": "1.0",
    "tlctc_version": "2.1",
    "applies_to": "KEV entries whose derived mapping expression contains the alternation '#2 | #3'.",
    "match_semantics": {
      "field": "Concatenation of `vendorProject` + ' :: ' + `product` (case-insensitive).",
      "order": "Rules are evaluated top-to-bottom. FIRST MATCH WINS. Specific product rules precede vendor-wide defaults.",
      "no_match": "If no rule matches, the entry is emitted with contextResolvedBy = 'unresolved' and primaryCluster taken from the left-most alternative as a fallback. This preserves auditability: a reviewer can see the heuristic had nothing to say."
    },
    "maintenance": "This table is reviewable and versioned. When adding a rule, prefer narrow patterns over vendor-wide defaults. Record the reasoning in `notes`."
  },
